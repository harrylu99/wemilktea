{
  "name": "wemilktea-v1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.22",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:public": "bun --filter @wemilktea/public dev",
    "dev:admin": "bun --filter @wemilktea/admin dev",
    "build": "bun --filter '@wemilktea/*' run build",
    "lint": "eslint .",
    "test": "bun --filter '@wemilktea/*' run test",
    "typecheck": "bun --filter '@wemilktea/*' run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.42.0"
  },
  "dependencies": {
    "bun": "^1.3.14"
  }
}
