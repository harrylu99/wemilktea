{
  "name": "wemilktea-v1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun --filter @wemilktea/web dev",
    "dev:admin": "bun --filter @wemilktea/admin dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "build": "bun --filter @wemilktea/web build && bun --filter @wemilktea/admin build",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.62.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.42.0"
  }
}
