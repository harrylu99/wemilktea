{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wemilktea-moments-image-verifier",
  "main": "index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "configure-at-deploy"
    }
  ]
}
